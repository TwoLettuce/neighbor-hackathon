POSTGRES_DB=networking_events
POSTGRES_USER=networking
POSTGRES_PASSWORD=networking
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Production alternative to the POSTGRES_* values above:
DATABASE_URL=

DJANGO_SECRET_KEY=development-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Passed to the frontend build (or saved as frontend/.env.local).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional integrations
GEOCODING_PROVIDER=fixture
GEOCODING_API_KEY=
TICKETMASTER_API_KEY=
# Optional override for tests or a compatible proxy; normally leave blank/unset.
# TICKETMASTER_API_BASE_URL=https://app.ticketmaster.com/discovery/v2/events.json
LLM_API_KEY=
EVENTBRITE_API_TOKEN=
MEETUP_API_TOKEN=
